# Copie para .env somente no seu ambiente privado. Não use credenciais dos ZIPs antigos.
NODE_ENV=development
PORT=3000
FIREBASE_PROJECT_ID=lumuz-e2f23
# Configure UMA fonte válida de credenciais administrativas (ou ADC do ambiente).
# O caminho pode apontar para arquivo privado fora do repositório.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Opcional: PostgreSQL com certificado válido; vazio usa SQLite local persistente.
DATABASE_URL=
# Lista de origens HTTPS quando frontend/API usam domínios diferentes.
CORS_ORIGINS=
# 0 sem proxy. Ajuste somente conforme proxies confiáveis do seu host.
TRUST_PROXY_HOPS=0
# Chat: endereço do servidor PHP; HTTPS obrigatório em produção.
OLLAMA_URL=
# Mesmo segredo aleatório de 32 a 256 caracteres no Node e no PHP. Nunca enviar ao navegador.
OLLAMA_BRIDGE_SECRET=
OLLAMA_MODEL=llama3.2:1b
# Provedores de cotação opcionais.
BRAPI_TOKEN=
COINGECKO_API_KEY=
